{
  "name": "monedas",
  "version": "1.0.0",
  "private": true,
  "description": "Monedas · educación financiera para chicos. App para iOS y Android (Capacitor) y PWA instalable.",
  "scripts": {
    "serve": "npx --yes serve www -l 5173",
    "icons": "powershell -ExecutionPolicy Bypass -File tools/make-icons.ps1",
    "cap:init": "npx cap init Monedas ar.com.monedas.app --web-dir www",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "assets": "npx --yes @capacitor/assets generate --iconBackgroundColor \"#241A5B\" --iconBackgroundColorDark \"#241A5B\" --splashBackgroundColor \"#241A5B\" --splashBackgroundColorDark \"#241A5B\""
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
