{
  "appId": "ar.com.monedas.app",
  "appName": "Monedas",
  "webDir": "www",
  "backgroundColor": "#241A5B",
  "android": {
    "backgroundColor": "#241A5B",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#241A5B",
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#241A5B",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#160F3B",
      "overlaysWebView": false
    }
  }
}
